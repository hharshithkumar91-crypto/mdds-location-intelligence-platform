# Environment Variables Configuration
# Copy this file to .env and supply actual credentials

# Database (NeonDB Serverless PostgreSQL)
DATABASE_URL="postgresql://neondb_owner:<password>@<neon-host>/neondb?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://neondb_owner:<password>@<neon-host>/neondb?sslmode=require"

# Cache & Rate Limiting (Upstash Redis)
UPSTASH_REDIS_REST_URL="https://<upstash-endpoint>.upstash.io"
UPSTASH_REDIS_REST_TOKEN="<upstash-rest-token>"

# Security & Authentication
JWT_SECRET="your-super-secure-jwt-secret-at-least-32-chars"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="7d"

# Server Configuration
PORT=5000
NODE_ENV="development"
CORS_ORIGIN="http://localhost:5173,https://workspace.boldanalytics.in"
